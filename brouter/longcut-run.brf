# LONGCUT running profile for BRouter.
# Goal: quiet roads, paths and footways; avoid busy roads. Distance is fixed by
# the planner, so these costs only decide WHICH roads the route uses.
#
# Costs are "how much one meter here feels like": 1.0 = ideal.
# The app uploads one copy of this profile per combination of options.

---context:global

assign avoid_unpaved = true   # %avoid_unpaved% | Mildly avoid unpaved paths | boolean
assign prefer_green  = false  # %prefer_green% | Prefer parks, forests and green areas | boolean
assign prefer_lit    = false  # %prefer_lit% | Prefer streets with street lights (running in the dark) | boolean
assign prefer_trail  = false  # %prefer_trail% | Mostly trail: seek out unpaved ways, paved roads cost more | boolean

assign validForFoot 1
assign turnInstructionMode 0
assign downhillcost 0
assign downhillcutoff 1.5
assign uphillcost 0
assign uphillcutoff 1.5

---context:way

assign ispaved or surface=paved or surface=asphalt or surface=concrete or surface=paving_stones surface=sett
# Half-paved (gravel, dolomite, crushed stone) runs fine: it counts as good.
assign ishalfpaved surface=compacted|fine_gravel|gravel|pebblestone|grass_paver
# Soft: dirt, grass, sand, mud, forest paths (known surface, or a rough track type).
assign issoft or ( and not ispaved and not ishalfpaved not surface= )
                 ( and surface= and highway=track tracktype=grade3|grade4|grade5 )
# No surface known: paths and field tracks without a track type (often fine, sometimes not).
assign isunknownsurface and surface= or highway=path|bridleway and highway=track not tracktype=grade1|grade2|grade3|grade4|grade5
assign issidewalk sidewalk=left|right|both|yes|separate
assign isroute or route_hiking_iwn=yes or route_hiking_nwn=yes or route_hiking_rwn=yes or route_hiking_lwn=yes
              or route_foot_nwn=yes or route_foot_rwn=yes route_foot_lwn=yes

assign defaultaccess switch access= not motorroad=yes switch or access=private access=no 0 1
assign footaccess
  or issidewalk
  switch foot= switch highway=cycleway 1 defaultaccess not foot=private|no|use_sidepath

# Base cost by road type.
assign roadcost
  if highway=motorway|motorway_link|proposed|construction|abandoned|platform then 100000
  else if highway=footway|path|pedestrian|living_street|track|bridleway then 1.0
  else if highway=cycleway then 1.05
  else if highway=steps then 1.6
  else if highway=residential|service|road then 1.15
  else if highway=unclassified then 1.3
  else if highway=tertiary|tertiary_link then ( if issidewalk then 1.8 else 2.6 )
  else if highway=secondary|secondary_link then ( if issidewalk then 2.6 else 4.0 )
  else if highway=primary|primary_link|trunk|trunk_link then ( if issidewalk then 4.0 else 8.0 )
  else if route=ferry then 100000
  else if highway= then 100000
  else 1.5

# Extra cost from estimated traffic (computed by BRouter from OSM data).
assign trafficcost
  if estimated_traffic_class=6|7 then 1.5
  else if estimated_traffic_class=5 then 0.9
  else if estimated_traffic_class=4 then 0.5
  else if estimated_traffic_class=3 then 0.2
  else 0

# Paths right next to a motorway or busy road are allowed but less pleasant.
assign noisecost
  if estimated_noise_class=6 then 0.5
  else if estimated_noise_class=5 then 0.35
  else if estimated_noise_class=4 then 0.15
  else 0

assign unpavedcost
  if not avoid_unpaved then 0
  else if issoft then ( if surface=mud|sand|grass then 0.6 else 0.35 )
  else if isunknownsurface then 0.15
  else 0

assign greenbonus
  if not prefer_green then 0
  else if estimated_forest_class=6 then -0.35
  else if estimated_forest_class=5 then -0.3
  else if estimated_forest_class=4 then -0.2
  else if estimated_forest_class=3 then -0.1
  else 0

# In the dark: prefer streets known to be lit. Town streets are usually lit even when
# not tagged; field tracks, paths and country roads usually are not.
assign litcost
  if not prefer_lit then 0
  else if lit=yes then 0
  else if highway=residential|living_street|pedestrian|service then 0.2
  else if highway=unclassified|tertiary|tertiary_link|secondary|secondary_link|primary then 0.5
  else 1.3

# Mostly trail: forest and field paths, tracks and gravel are what you're after;
# paved roads (also quiet ones) cost extra.
assign trailcost
  if not prefer_trail then 0
  else if issoft then -0.3
  else if isunknownsurface then -0.25
  else if ishalfpaved then -0.2
  else if highway=track|path|bridleway then -0.1
  else 0.9

# Signed walking routes (wandelnetwerk, GR) are usually nice: small bonus.
assign routebonus if isroute then -0.08 else 0

assign costfactor
  if not footaccess then 100000
  else max 0.75 ( add roadcost add trafficcost add noisecost add litcost add unpavedcost add trailcost add greenbonus routebonus )

assign turncost 0
assign initialcost 0

---context:node

assign defaultaccess switch access= 1 switch or access=private access=no 0 1
assign footaccess switch foot= defaultaccess switch or foot=private foot=no 0 1
assign initialcost switch footaccess 0 1000000
